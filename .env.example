# Settings for the optional LLM judge (`gce score --judge deepseek`).
# Copy to .env, fill in the key, and keep .env private (chmod 600 .env). .env is git-ignored.
# Variables exported in your shell take precedence over this file.
DEEPSEEK_API_KEY=
# Optional (defaults shown).
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# none disables thinking (temperature 0); low | medium | high | max enable it with that effort.
DEEPSEEK_REASONING_EFFORT=none
# Cache verdicts by prompt hash so re-scoring makes no new calls (leave empty to disable).
GCE_JUDGE_CACHE=out/judge_cache
GCE_JUDGE_TIMEOUT=120
